      "minHeight": {
        "windows": { "$type": "dimension", "$value": "620px" },
        "macos": { "$type": "dimension", "$value": "600px" }
      }
    }
  },
  "type": {
    "windowTitle": {
      "windows": {
        "$type": "typography",
        "$value": { "fontFamily": "Segoe UI Variable, Segoe UI", "fontSize": "20px", "fontWeight": 600, "lineHeight": "28px" }
