  "motion": {
    "fast": { "$type": "duration", "$value": "150ms" },
    "normal": { "$type": "duration", "$value": "200ms" },
    "standardEasing": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "opacity": {
    "disabled": { "$type": "number", "$value": 0.6 }
  },
  "macos": {
    "semantic": {
      "color.bg.canvas": "windowBackgroundColor",
      "color.bg.surface": "controlBackgroundColor",
      "color.bg.surfaceSubtle": "underPageBackgroundColor",
      "color.stroke.default": "separatorColor",
      "color.stroke.strong": "gridColor",
      "color.text.primary": "labelColor",
      "color.text.secondary": "secondaryLabelColor",
      "color.text.tertiary": "tertiaryLabelColor"
    }
  }
}
