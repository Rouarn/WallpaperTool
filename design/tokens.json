{
  "$description": "壁纸工具共享设计 token。唯一来源：Windows 与 macOS 的色值、尺寸、字号、动效均由此生成，禁止在界面代码中写死。",
  "$version": "1.0.0",
  "color": {
    "bg": {
      "canvas": {
        "light": { "$type": "color", "$value": "#F3F3F3" },
        "dark": { "$type": "color", "$value": "#1F1F1F" }
      },
      "surface": {
        "light": { "$type": "color", "$value": "#FFFFFF" },
        "dark": { "$type": "color", "$value": "#2B2B2B" }
      },
      "surfaceSubtle": {
        "light": { "$type": "color", "$value": "#FAFAFA" },
        "dark": { "$type": "color", "$value": "#323232" }
      }
    },
    "stroke": {
      "default": {
        "light": { "$type": "color", "$value": "rgba(0,0,0,0.06)" },
        "dark": { "$type": "color", "$value": "rgba(255,255,255,0.09)" }
      },
      "strong": {
        "light": { "$type": "color", "$value": "rgba(0,0,0,0.16)" },
        "dark": { "$type": "color", "$value": "rgba(255,255,255,0.22)" }
