      "windows": {
        "$type": "typography",
        "$value": { "fontFamily": "Segoe UI Variable, Segoe UI", "fontSize": "12px", "fontWeight": 400, "lineHeight": "16px" }
      },
      "macos": {
        "$type": "typography",
        "$value": { "fontFamily": "SF Pro", "fontSize": "11pt", "fontWeight": 400, "lineHeight": "14pt" }
      }
    },
    "mono": {
      "windows": {
        "$type": "typography",
        "$value": { "fontFamily": "Consolas", "fontSize": "12px", "fontWeight": 400, "lineHeight": "18px" }
      },
      "macos": {
        "$type": "typography",
        "$value": { "fontFamily": "SF Mono", "fontSize": "11pt", "fontWeight": 400, "lineHeight": "16pt" }
      }
    }
