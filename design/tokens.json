    "toggleWidth": {
      "windows": { "$type": "dimension", "$value": "40px" },
      "macos": { "$type": "dimension", "$value": "38px" }
    },
    "toggleHeight": {
      "windows": { "$type": "dimension", "$value": "20px" },
      "macos": { "$type": "dimension", "$value": "22px" }
