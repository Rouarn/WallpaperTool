      },
      "macos": {
        "$type": "typography",
        "$value": { "fontFamily": "SF Pro", "fontSize": "13pt", "fontWeight": 600, "lineHeight": "16pt" }
      }
    },
    "body": {
      "windows": {
        "$type": "typography",
        "$value": { "fontFamily": "Segoe UI Variable, Segoe UI", "fontSize": "14px", "fontWeight": 400, "lineHeight": "20px" }
      },
      "macos": {
        "$type": "typography",
        "$value": { "fontFamily": "SF Pro", "fontSize": "13pt", "fontWeight": 400, "lineHeight": "16pt" }
      }
    },
    "bodyStrong": {
      "windows": {
        "$type": "typography",
        "$value": { "fontFamily": "Segoe UI Variable, Segoe UI", "fontSize": "14px", "fontWeight": 600, "lineHeight": "20px" }
      },
      "macos": {
        "$type": "typography",
        "$value": { "fontFamily": "SF Pro", "fontSize": "13pt", "fontWeight": 600, "lineHeight": "16pt" }
      }
    },
