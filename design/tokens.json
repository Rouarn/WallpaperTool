    "iconLarge": { "$type": "dimension", "$value": "20px" },
    "progressBar": { "$type": "dimension", "$value": "4px" },
    "headerHeight": { "$type": "dimension", "$value": "56px" },
    "statusBarHeight": { "$type": "dimension", "$value": "32px" },
    "logPanelHeight": { "$type": "dimension", "$value": "200px" },
    "rowHeight": {
      "windows": { "$type": "dimension", "$value": "22px" },
      "macos": { "$type": "dimension", "$value": "20px" }
